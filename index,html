<script>


/* =========================
   VARIABLES
========================= */

const canvas=
document.getElementById("drawingCanvas");

const ctx=
canvas.getContext("2d");


let currentPart="head";

let currentTool="red";

let intensity=5;

let drawing=false;

let lastX=0;

let lastY=0;

let symptoms=[];


/* =========================
   BODY NAMES
========================= */

const partNames={

head:"Head",

neck:"Neck & Shoulders",

chest:"Chest",

abdomen:"Abdomen",

back:"Back",

arms:"Arms",

legs:"Legs",

feet:"Feet"

};


/* =========================
   CANVAS
========================= */

function resizeCanvas(){

const area=
document.querySelector(".body-area");

canvas.width=area.clientWidth;

canvas.height=area.clientHeight;

ctx.clearRect(
0,
0,
canvas.width,
canvas.height
);

}


window.addEventListener(
"resize",
resizeCanvas
);

resizeCanvas();


/* =========================
   SELECT BODY PART
========================= */

function selectPart(part,button){

currentPart=part;


/* change title */

document.getElementById(
"bodyTitle"
).textContent=partNames[part];


/* change active button */

document
.querySelectorAll(".parts button")
.forEach(btn=>{
btn.classList.remove("active");
});

button.classList.add("active");


/* hide every body image */

document
.querySelectorAll(".body-svg")
.forEach(svg=>{
svg.style.display="none";
});


/* show selected image */

const selected=
document.getElementById(
part+"Svg"
);

if(selected){

selected.style.display="block";

}


/* clear previous drawing */

clearDrawing();

}


/* =========================
   TOOLS
========================= */

function setTool(tool,button){

currentTool=tool;

document
.querySelectorAll(".tools button")
.forEach(btn=>{
btn.classList.remove("active");
});

button.classList.add("active");

}


/* =========================
   DRAWING
========================= */

canvas.addEventListener(
"pointerdown",
function(e){

drawing=true;

canvas.setPointerCapture(
e.pointerId
);

const rect=
canvas.getBoundingClientRect();

lastX=
e.clientX-rect.left;

lastY=
e.clientY-rect.top;

}
);


canvas.addEventListener(
"pointermove",
function(e){

if(!drawing)return;

const rect=
canvas.getBoundingClientRect();

const x=
e.clientX-rect.left;

const y=
e.clientY-rect.top;

drawLine(
lastX,
lastY,
x,
y
);

lastX=x;
lastY=y;

}
);


canvas.addEventListener(
"pointerup",
function(){

drawing=false;

}
);


canvas.addEventListener(
"pointercancel",
function(){

drawing=false;

}
);


/* =========================
   DRAW
========================= */

function drawLine(
x1,
y1,
x2,
y2
){

if(currentTool==="dot"){

ctx.fillStyle="#ffffff";

ctx.beginPath();

ctx.arc(
x2,
y2,
5,
0,
Math.PI*2
);

ctx.fill();

return;

}


if(currentTool==="arrow"){

drawArrow(x2,y2);

return;

}


ctx.lineCap="round";

ctx.lineJoin="round";


if(currentTool==="red"){

ctx.strokeStyle="#ff5364";

ctx.lineWidth=15;

}

if(currentTool==="black"){

ctx.strokeStyle="#111111";

ctx.lineWidth=15;

}

if(currentTool==="blue"){

ctx.strokeStyle="#60e7ff";

ctx.lineWidth=12;

}

if(currentTool==="purple"){

ctx.strokeStyle="#bd82ff";

ctx.lineWidth=12;

}

if(currentTool==="yellow"){

ctx.strokeStyle="#ffd84d";

ctx.lineWidth=12;

}

if(currentTool==="wave"){

ctx.strokeStyle="#60e7ff";

ctx.lineWidth=4;

}


ctx.beginPath();

ctx.moveTo(x1,y1);

ctx.lineTo(x2,y2);

ctx.stroke();

}


/* =========================
   ARROW
========================= */

function drawArrow(x,y){

ctx.strokeStyle="#ffffff";

ctx.lineWidth=4;

ctx.beginPath();

ctx.moveTo(
x-40,
y
);

ctx.lineTo(
x+30,
y
);

ctx.moveTo(
x+30,
y
);

ctx.lineTo(
x+15,
y-12
);

ctx.moveTo(
x+30,
y
);

ctx.lineTo(
x+15,
y+12
);

ctx.stroke();

}


/* =========================
   CLEAR DRAWING
========================= */

function clearDrawing(){

ctx.clearRect(
0,
0,
canvas.width,
canvas.height
);

}


/* =========================
   RESET
========================= */

function resetDrawing(){

clearDrawing();

}


/* =========================
   INTENSITY
========================= */

function changeIntensity(value){

intensity=
Number(value);

document.getElementById(
"intensityValue"
).textContent=value;

}


/* =========================
   SAVE SYMPTOM
========================= */

function saveSymptom(){

const now=
new Date();

const time=
now.toLocaleTimeString(
"en-US",
{
hour:"2-digit",
minute:"2-digit"
}
);


const type=
document.getElementById(
"painType"
).value;


const comment=
document.getElementById(
"comment"
).value.trim();


const record={

time:time,

timestamp:Date.now(),

part:currentPart,

partName:partNames[currentPart],

intensity:intensity,

type:type,

comment:comment

};


symptoms.push(record);


updateTimeline();

generateAISummary();


document.getElementById(
"comment"
).value="";


alert(
"Symptom saved successfully."
);

}


/* =========================
   TIMELINE
========================= */

function updateTimeline(){

const timeline=
document.getElementById(
"timeline"
);

timeline.innerHTML="";


if(symptoms.length===0){

timeline.innerHTML=`

<div class="empty">

No symptoms recorded yet.

</div>

`;

return;

}


symptoms.forEach(item=>{

const div=
document.createElement(
"div"
);

div.className=
"timeline-item";


div.innerHTML=`

<div class="timeline-time">

${item.time}

</div>

<strong>

${item.partName}

</strong>

<p>

Intensity:
${item.intensity}/10

</p>

<p>

Type:
${item.type}

</p>

${
item.comment
?
`<p>
Notes:
${escapeHTML(item.comment)}
</p>`
:
""
}

`;


timeline.appendChild(div);

});

}


/* =========================
   AI SUMMARY
========================= */

function generateAISummary(){

if(symptoms.length===0){

return;

}


const first=
symptoms[0];

const last=
symptoms[symptoms.length-1];


const maxIntensity=
Math.max(
...symptoms.map(
s=>Number(s.intensity)
)
);


let trend="stable";


if(
last.intensity >
first.intensity
){

trend="increasing";

}


else if(
last.intensity <
first.intensity
){

trend="decreasing";

}


const areas=[
...new Set(
symptoms.map(
s=>s.partName
)
)
];


let locationText=
first.partName;


if(areas.length>1){

locationText=
areas.join(", ");

}


const summary=
document.getElementById(
"summary"
);


summary.innerHTML=`

<div class="stat">

<span>
Main area
</span>

<strong>
${first.partName}
</strong>

</div>


<div class="stat">

<span>
First recorded
</span>

<strong>
${first.time}
</strong>

</div>


<div class="stat">

<span>
Latest record
</span>

<strong>
${last.time}
</strong>

</div>


<div class="stat">

<span>
Maximum intensity
</span>

<strong>
${maxIntensity}/10
</strong>

</div>


<div class="stat">

<span>
Current trend
</span>

<strong>
${trend}
</strong>

</div>


<div class="stat">

<span>
Latest pain type
</span>

<strong>
${last.type}
</strong>

</div>


<div style="
margin-top:14px;
">

<strong
style="color:#6ee7ff"
>

AI-generated symptom description

</strong>

<br><br>

The symptom was first recorded in the
<strong>
${first.partName}
</strong>
with an intensity of
<strong>
${first.intensity}/10
