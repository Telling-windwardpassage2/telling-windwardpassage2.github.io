/* =========================
   CLEAR HISTORY
========================= */

function clearHistory(){

symptoms=[];

updateTimeline();

document.getElementById(
"summary"
).innerHTML=

"AI-assisted summary will appear after you save a symptom.";

}


/* =========================
   SECURITY
========================= */

function escapeHTML(text){

const div=
document.createElement(
"div"
);

div.textContent=text;

return div.innerHTML;

}

