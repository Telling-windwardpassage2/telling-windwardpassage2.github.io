<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SymptomCanvas</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#080d1a;
    color:#ffffff;
    min-height:100vh;
}

header{
    height:75px;
    padding:0 5%;
    border-bottom:1px solid #20283b;
    display:flex;
    align-items:center;
    justify-content:space-between;
}

.logo{
    font-size:25px;
    font-weight:700;
}

.logo span{
    color:#6ee7ff;
}

header p{
    color:#778198;
    font-size:14px;
}

main{
    width:94%;
    max-width:1450px;
    margin:25px auto;
}

.grid{
    display:grid;
    grid-template-columns:250px minmax(450px,1fr) 320px;
    gap:18px;
}

.card{
    background:#11182a;
    border:1px solid #222c42;
    border-radius:18px;
    padding:18px;
}

h2{
    margin-bottom:15px;
    font-size:22px;
}

h3{
    margin-bottom:12px;
    font-size:16px;
}


/* BODY PART BUTTONS */

.parts{
    display:flex;
    flex-direction:column;
    gap:8px;
}

.parts button{
    width:100%;
    padding:12px;
    background:#182138;
    border:1px solid #2b3650;
    color:white;
    border-radius:9px;
    cursor:pointer;
    text-align:left;
    font-size:14px;
    transition:.2s;
}

.parts button:hover{
    background:#22304a;
}

.parts button.active{
    background:#173b4c;
    border-color:#6ee7ff;
}


/* LEGEND */

.legend{
    display:flex;
    flex-direction:column;
    gap:7px;
    margin-top:15px;
}

.legend div{
    background:#182138;
    border-radius:8px;
    padding:8px;
    font-size:13px;
}

.red{
    color:#ff5364;
}

.black{
    color:#d9dce4;
}

.blue{
    color:#60e7ff;
}

.purple{
    color:#bd82ff;
}

.yellow{
    color:#ffd84d;
}


/* BODY AREA */

.body-area{
    width:100%;
    height:580px;
    background:#0b1120;
    border:1px solid #222d45;
    border-radius:14px;
    display:flex;
    align-items:center;
    justify-content:center;
    position:relative;
    overflow:hidden;
}

.body-svg{
    width:100%;
    height:100%;
    max-width:600px;
}

.body-shape{
    fill:#151f34;
    stroke:#64728f;
    stroke-width:3;
}

.body-detail{
    fill:none;
    stroke:#64728f;
    stroke-width:2;
}

.body-title{
    position:absolute;
    top:15px;
    left:50%;
    transform:translateX(-50%);
    color:#65718d;
    font-size:13px;
}


/* DRAWING LAYER */

.drawing-layer{
    position:absolute;
    width:100%;
    height:100%;
    top:0;
    left:0;
    pointer-events:none;
}

.drawing-layer.active{
    pointer-events:auto;
    cursor:crosshair;
}


/* TOOLS */

.tools{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:7px;
    margin-top:12px;
}

.tools button{
    height:40px;
    background:#182138;
    border:1px solid #2b3650;
    border-radius:8px;
    color:white;
    cursor:pointer;
    font-size:17px;
}

.tools button:hover{
    background:#26334e;
}

.tools button.active{
    border-color:#6ee7ff;
    background:#20384b;
}


/* FORM */

label{
    display:block;
    font-size:13px;
    color:#929db5;
    margin-top:14px;
    margin-bottom:6px;
}

input,
select{
    width:100%;
    height:40px;
    padding:0 11px;
    background:#0c1322;
    border:1px solid #2b3650;
    border-radius:8px;
    color:white;
    outline:none;
}

input:focus,
select:focus{
    border-color:#6ee7ff;
}

input[type="range"]{
    padding:0;
    accent-color:#6ee7ff;
}


/* SAVE */

.save-btn{
    width:100%;
    height:43px;
    margin-top:17px;
    background:#6ee7ff;
    color:#061019;
    border:0;
    border-radius:9px;
    font-weight:bold;
    cursor:pointer;
    font-size:14px;
}

.save-btn:hover{
    background:#8cecff;
}


/* TIMELINE */

.timeline{
    max-height:360px;
    overflow-y:auto;
    padding-right:4px;
}

.timeline::-webkit-scrollbar{
    width:5px;
}

.timeline::-webkit-scrollbar-thumb{
    background:#34405b;
    border-radius:10px;
}

.timeline-item{
    border-left:3px solid #6ee7ff;
    background:#182138;
    border-radius:0 9px 9px 0;
    padding:11px;
    margin-bottom:10px;
    font-size:13px;
}

.timeline-time{
    color:#6ee7ff;
    font-weight:bold;
    margin-bottom:4px;
}

.timeline-item p{
    color:#aeb7ca;
    margin-top:4px;
}

.empty{
    text-align:center;
    color:#657089;
    padding:30px 5px;
}


/* AI */

.ai-box{
    margin-top:15px;
    background:#0c1322;
    border:1px solid #26334d;
    border-radius:11px;
    padding:13px;
    font-size:13px;
    line-height:1.6;
    color:#c1c9d9;
}

.ai-title{
    display:flex;
    align-items:center;
    gap:7px;
    color:#6ee7ff;
    font-weight:bold;
    margin-bottom:10px;
}

.stat{
    display:flex;
    justify-content:space-between;
    padding:7px 0;
    border-bottom:1px solid #202a40;
}

.stat:last-child{
    border-bottom:none;
}

.stat span:first-child{
    color:#77839b;
}

.clear-history{
    width:100%;
    margin-top:10px;
    padding:9px;
    background:transparent;
    border:1px solid #303b55;
    border-radius:8px;
    color:#8994aa;
    cursor:pointer;
}


@media(max-width:1100px){

    .grid{
        grid-template-columns:220px 1fr;
    }

    .grid .card:last-child{
        grid-column:1/-1;
    }

}


@media(max-width:750px){

    .grid{
        grid-template-columns:1fr;
    }

    .body-area{
        height:500px;
    }

    .tools{
        grid-template-columns:repeat(3,1fr);
    }

    header p{
        display:none;
    }

}

</style>
</head>


